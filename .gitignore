# environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# LaTeX build files (paper/main.pdf is kept)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/build*.log

# regenerable large data: rebuild with `python data_gen/make_splits.py`, check with data/real_SHA256SUMS.txt
data/real/*
!data/real/dev/
data/real/dev/*
!data/real/dev/source_train.jsonl
!data/real/dev/source_select.jsonl
!data/real/dev/source_audit.jsonl
data/real3/
data/real_gemma/
data/real_qwen/

# concatenations of runs/*/units/*.pkl; run_rbcal.py rebuilds them from the unit cache
runs/*/unit_results.pkl

# polling scratch files
runs/colab_poll*.txt

# credentials (Kaggle / Hugging Face tokens) - never commit
.env
.env.*

# large per-unit fits of the confirm2-4 rosters (765 MB): hosted on Hugging Face, see README "Large artifacts"
runs/rbcal_confirm2/units/
runs/rbcal_confirm3/units/
runs/rbcal_confirm4/units/

# LNCS build files (paper_lncs/main.pdf is kept)
paper_lncs/*.aux
paper_lncs/*.bbl
paper_lncs/*.blg
paper_lncs/*.log
paper_lncs/*.out
